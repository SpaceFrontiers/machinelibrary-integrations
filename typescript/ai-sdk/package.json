  "homepage": "https://machinelibrary.ai",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "ai": ">=5",
    "zod": ">=3.25"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ai": "^7.0.127",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceFrontiers/machinelibrary-integrations.git",
    "directory": "typescript/ai-sdk"
  }
