{
  "name": "@machinelibrary/ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK tools for Machine Library: citable search over papers, books, patents, standards and Wikipedia.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai-sdk",
    "vercel-ai",
    "tools",
    "rag",
